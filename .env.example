# ECHO AI Provider Configuration (Optional)
# Copy this file to .env or export these variables in your environment for local testing.
# WARNING: Do NOT commit API keys to version control!

ECHO_AI_ENABLED=false
ECHO_AI_PROVIDER=openrouter
ECHO_AI_TIMEOUT_SECONDS=20

# OpenRouter Settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/meistro57/ECHO
OPENROUTER_APP_NAME=ECHO

# DeepSeek Direct Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
