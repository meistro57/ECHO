# ECHO Framework Configuration File (.env)
# Fill in your API keys below for local development and testing.
# IMPORTANT: This file (.env) is ignored by git so your secrets remain safe.

# ==========================================
# 🧠 Brain & AI Decision Settings (Phase 6)
# ==========================================
ECHO_BRAIN_MODE=deterministic              # deterministic | ai
ECHO_AI_DECISION_INTERVAL_SECONDS=1.0      # Time between AI decision queries (seconds)
ECHO_AI_MIN_EVENT_INTERVAL_SECONDS=0.25    # Min time between event-triggered queries (seconds)

# ==========================================
# 🌐 AI Provider Settings (Phase 5)
# ==========================================
ECHO_AI_ENABLED=false                       # true | false
ECHO_AI_PROVIDER=openrouter                 # openrouter | deepseek
ECHO_AI_TIMEOUT_SECONDS=20

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/meistro57/ECHO
OPENROUTER_APP_NAME=ECHO

# DeepSeek Direct Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==========================================
# 🎙️ Speech-to-Text (STT) Settings (Phase 8)
# ==========================================
ECHO_STT_ENABLED=true                       # true | false
ECHO_STT_PROVIDER=mock                      # mock | openai_compatible | local
ECHO_STT_TIMEOUT_SECONDS=30
ECHO_STT_BASE_URL=https://api.openai.com/v1
ECHO_STT_API_KEY=your_stt_api_key_here
ECHO_STT_MODEL=whisper-1

# Local STT Settings (optional offline)
ECHO_LOCAL_STT_COMMAND=
ECHO_LOCAL_STT_MODEL_PATH=

# ==========================================
# 🗣️ Text-to-Speech (TTS) Settings (Phase 8)
# ==========================================
ECHO_TTS_ENABLED=true                       # true | false
ECHO_TTS_PROVIDER=mock                      # mock | openai_compatible | local
ECHO_TTS_TIMEOUT_SECONDS=30
ECHO_TTS_BASE_URL=https://api.openai.com/v1
ECHO_TTS_API_KEY=your_tts_api_key_here
ECHO_TTS_VOICE=alloy

# Local TTS Settings (optional offline)
ECHO_LOCAL_TTS_COMMAND=
ECHO_LOCAL_TTS_VOICE=

# ==========================================
# 🎛️ Push-To-Talk Settings (Phase 8)
# ==========================================
ECHO_PTT_MIN_SECONDS=0.25
ECHO_PTT_MAX_SECONDS=20.0
