# ECHO Framework Configuration
# Copy this file to .env or export these variables in your environment for local testing.
# WARNING: Do NOT commit API keys to version control!

# Phase 6 Brain Configuration
ECHO_BRAIN_MODE=deterministic
ECHO_AI_DECISION_INTERVAL_SECONDS=1.0
ECHO_AI_MIN_EVENT_INTERVAL_SECONDS=0.25

# Phase 5 AI Provider Settings
ECHO_AI_ENABLED=false
ECHO_AI_PROVIDER=openrouter
ECHO_AI_TIMEOUT_SECONDS=20

# OpenRouter Settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/meistro57/ECHO
OPENROUTER_APP_NAME=ECHO

# DeepSeek Direct Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
